# Copy this file to .env and fill in your values before running docker compose.

# ─── Required ─────────────────────────────────────────────────────────────────

# GitHub personal access token.
# Increases the GitHub API rate limit from 60 req/hr to 1000 req/hr.
# Create one at https://github.com/settings/tokens (no special scopes needed for public repos).
GITHUB_TOKEN=ghp_your_token_here

# The GitHub repo that docs are fetched from (owner/repo format).
# This value is also baked into the client bundle at build time by Vite.
VITE_SOURCE_REPO=dreamy-ui/dreamy-ui

# ─── Optional ─────────────────────────────────────────────────────────────────

# SQLite database for synced docs (path is relative to /repo/website in Docker).
DATABASE_URL=file:./prisma/data.db

# Redis auth (64-char hex, no symbols — safe inside redis:// URLs).
# Coolify auto-generates SERVICE_PASSWORD_64_REDIS when you deploy docker-compose.yml.
# Locally: run `pnpm docker:env` (or `node scripts/ensure-compose-env.mjs`) before `docker compose up`.
# SERVICE_PASSWORD_64_REDIS=
